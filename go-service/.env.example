# Supabase -> Connect -> "Session pooler" (port 5432) or "Transaction pooler" (6543).
# NOT the direct connection string: that host is IPv6-only.
DATABASE_URL=postgresql://postgres.ngxbytljmnrgxhnnajrn:YOUR_PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# From whoever on your team owns the Bright Data account.
BRIGHTDATA_TOKEN=

# Any long random string. Register the same value as a header on the
# Bright Data webhook so strangers can't POST rows into your database.
WEBHOOK_SECRET=

ADDR=:8080
WORKERS=4

# Leave false until you have watched `bdata scraper heal` work by hand once.
AUTO_HEAL=false

# Skip the human approval gate on heal. Leave false: you want to see
# preview_result before a fix goes live.
AUTO_APPROVE=false

# Fraction of rows with an empty price/title/url that marks a collector broken.
BROKEN_NULL_RATE=0.5

# --- Cloudflare R2 -----------------------------------------------
# R2 -> Overview for the account ID, then Manage API tokens for the keys.
# Leave R2_BUCKET empty and raw payloads land in ./raw instead, so you can
# build the whole pipeline before anyone hands you credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scrape-verse-raw
LOCAL_RAW_DIR=./raw
